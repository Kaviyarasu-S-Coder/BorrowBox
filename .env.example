# ============================================================
# BORROWBOX ENVIRONMENT CONFIGURATION
# ============================================================

# Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Development uses H2, Production uses PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borrowbox
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Redis Cache & Messaging
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Uploads
UPLOAD_DIR=uploads/items
MAX_FILE_SIZE=10MB

# Mail Configuration (Optional for notifications)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=http://localhost:8080/ws
